# Dashboard configuration for local development (`make run`).
# Copy to .env and adjust: cp .env.example .env
# NEVER commit .env. Commented variables show their default value.
# Every secret also accepts a *_FILE variant (e.g. Docker/Swarm secrets).

# --- APISIX Admin API (required) --------------------------------------------
DASH_ADMIN_API_URL=http://127.0.0.1:9180
# APISIX admin key (deployment.admin.admin_key in APISIX config.yaml).
DASH_ADMIN_API_KEY=change-me
# DASH_ADMIN_API_KEY_FILE=/run/secrets/apisix_admin_key
# CA bundle to verify an HTTPS Admin API.
# DASH_ADMIN_API_CA_FILE=
# DASH_ADMIN_API_TIMEOUT=10s

# --- HTTP server ------------------------------------------------------------
# DASH_LISTEN_ADDR=:8080
# DASH_TLS_CERT_FILE=
# DASH_TLS_KEY_FILE=
# Without TLS (outside localhost) browsers do not send Secure cookies.
# Keep the default (true) in any non-local environment.
DASH_COOKIE_SECURE=false
# Reverse proxies allowed to set X-Forwarded-For / X-Real-IP (CIDR list).
# DASH_TRUSTED_PROXIES=10.0.0.0/8
# Deprecated: use DASH_TRUSTED_PROXIES (true = trust only the direct peer).
# DASH_TRUST_PROXY_HEADERS=false

# --- Data and encryption ----------------------------------------------------
# DASH_DATA_DIR=./data
# Default: $DASH_DATA_DIR/encryption.key (generated on first start; back it up).
# DASH_ENCRYPTION_KEY_FILE=
# Audit log mirror: stdout | none | /path/to/file
# DASH_AUDIT_LOG=stdout

# --- Sessions and lockout (defaults meet PCI DSS) ---------------------------
# DASH_SESSION_IDLE_TIMEOUT=15m
# DASH_SESSION_MAX_LIFETIME=12h
# DASH_MAX_LOGIN_ATTEMPTS=6
# DASH_LOCKOUT_DURATION=30m
# Authentication attempts per client IP per minute (429 above it).
# DASH_LOGIN_RATE_PER_MINUTE=20
# Concurrent password hashes (64 MiB each).
# DASH_LOGIN_CONCURRENCY=2

# --- Automatic certificates (Let's Encrypt DNS-01 via Cloudflare) -----------
# Enabled when the Cloudflare token is set.
# DASH_ACME_CLOUDFLARE_API_TOKEN=
# DASH_ACME_CLOUDFLARE_API_TOKEN_FILE=
# DASH_ACME_EMAIL=
# DASH_ACME_RENEW_BEFORE=720h
# DASH_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
# DASH_ACME_STAGING_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
# DASH_ACME_CA_FILE=
# DASH_ACME_DNS_RESOLVER=
# DASH_ACME_PROPAGATION_TIMEOUT=2m
# Only for tests against a Cloudflare API mock.
# DASH_ACME_CLOUDFLARE_API_URL=https://api.cloudflare.com/client/v4

# --- Kong migration (read-only access to Kong) ------------------------------
# Enabled when the URL is set.
# DASH_KONG_ADMIN_URL=http://127.0.0.1:8001
# DASH_KONG_ADMIN_TOKEN=
# DASH_KONG_ADMIN_TOKEN_FILE=
# DASH_KONG_ADMIN_TOKEN_HEADER=Kong-Admin-Token
# DASH_KONG_WORKSPACE=
# DASH_KONG_CA_FILE=
# DASH_KONG_TIMEOUT=30s
