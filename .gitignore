# --- Secrets / local config (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
secrets/

# --- Runtime data ---
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.pid
*.log

# --- Go build output ---
/bin/
/dist/
*.exe
*.test
*.out
coverage.*
/apisix-dashboard

# --- Frontend ---
node_modules/
web/dist/
web/build/
web/coverage/
*.tsbuildinfo
.vite/
.eslintcache
# Built SPA embedded into the binary (generated by `make web`)
internal/web/dist/*
!internal/web/dist/.gitkeep

# --- IDE / OS ---
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Claude Code (personal settings) ---
.claude/settings.local.json
