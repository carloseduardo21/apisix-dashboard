{
  "name": "apisix-dashboard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && touch ../internal/web/dist/.gitkeep",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --max-warnings 0 src",
    "lint:fast": "oxlint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@mantine/modals": "9.7.3",
    "@mantine/notifications": "9.7.3",
    "@mantine/spotlight": "9.7.3",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "5.104.5",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "postcss": "8.5.31",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
